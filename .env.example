# Copier ce fichier en .env.local puis renseigner la clé.

# --- OpenRouter (par défaut) : https://openrouter.ai/keys
OPENROUTER_API_KEY=colle-ta-cle-ici
# Modèle avec appel d'outils. Payant très bon marché : anthropic/claude-haiku-5.5, deepseek/deepseek-v4.1-flash
# Gratuit (50 requêtes/jour sans crédit) : nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# --- Ollama (local, optionnel) : décommenter pour l'utiliser
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1
